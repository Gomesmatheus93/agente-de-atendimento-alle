# Configuração do Allp Chat em desenvolvimento: um arquivo só, lido pela API, pelo worker, pelo
# painel (Vite) e pelos comandos do banco (pnpm db:*). Cada programa usa só o que precisa.
# O painel roda no navegador: o Vite só entrega a ele as variáveis que começam com VITE_ — nunca
# dê esse prefixo a um segredo. Em produção não há este arquivo: as variáveis vão por serviço no
# servidor (ver README).

# ── Banco (Supabase / Postgres) ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# Banco antigo (MySQL local), mantido só como plano B / cópia dos dados:
# MYSQL_DATABASE_URL=

# ── Filas (Redis) — API e worker ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────────────────────────────────
# Painel (tRPC): só a máquina local. Webhook: a única porta que a Meta precisa alcançar.
PAINEL_PORT=3334
PAINEL_HOST=127.0.0.1
WEBHOOK_PORT=3333

# ── Worker: WhatsApp ────────────────────────────────────────────────────────────────────────
# Conta, números e token do WhatsApp ficam em Configurações no painel, cifrados no banco.
# Simula os envios em vez de falar com a Meta (desenvolvimento sem credenciais).
WHATSAPP_SIMULAR=
# Trava de bancada: só estes telefones podem receber (vírgula separa). Vazio = sem trava.
WHATSAPP_NUMEROS_PERMITIDOS=
# Versão da Graph API e idioma padrão de template, quando o template não define o dele.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG=pt_BR

# ── Worker: IA (Anthropic) — sugestões do modo interno e análise diária ─────────────────────
# O bot do WhatsApp no modo n8n NÃO usa esta chave: a dele fica na credencial do n8n.
# A chave precisa pertencer a um workspace (console.anthropic.com → Settings → Workspaces).
ANTHROPIC_API_KEY=
# Chave da organização (não criada dentro de um workspace)? Informe o id do workspace, que fica em
# console.anthropic.com → Settings → Workspaces → clique no workspace (começa com wrkspc_).
ANTHROPIC_WORKSPACE_ID=
IA_MODELO=claude-opus-5
IA_ESFORCO=low

# ── Arquivos de mídia (API e worker) ────────────────────────────────────────────────────────
# Opcional: sem definir, usa <raiz do projeto>/uploads. Se definir, use caminho absoluto.
# UPLOADS_DIR=/caminho/absoluto/uploads

# ── Painel (Vite) — só VITE_* chega ao navegador ────────────────────────────────────────────
# O Vite repassa /trpc para o painel da API (vite.config.ts), então o endereço é relativo.
VITE_API_URL=/trpc
# Telefones de teste pré-preenchidos em Nova campanha (vírgula separa). Vazio em produção.
VITE_TELEFONES_TESTE=

# ── Instagram (API e worker) — conectar o Instagram de cada unidade e ver os insights ──────────
# developers.facebook.com → app → Instagram → "Configuração da API com login do Instagram": são o
# "ID do app do Instagram" e a "Chave secreta do app do Instagram" (diferentes dos do app do Facebook).
# No mesmo lugar, cadastre a URL de redirecionamento: https://<domínio do painel>/instagram/retorno
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: endereço público do painel, se a URL de retorno montada pelo servidor não bater com a cadastrada.
# PAINEL_URL_PUBLICA=https://poupe-alle-chat.gygwt3.easypanel.host
# Páginas públicas /privacidade e /exclusao-de-dados (exigidas pela Meta): quem opera e o contato.
PRIVACIDADE_EMPRESA=Allp Fit
PRIVACIDADE_EMAIL=
