DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

# Conta, números e token do WhatsApp ficam em Configurações no painel, cifrados no banco.
# O que sobra aqui são opções de comportamento:

# Simula os envios em vez de falar com a Meta (desenvolvimento sem credenciais).
WHATSAPP_SIMULAR=
# Trava de bancada: só estes telefones podem receber (vírgula separa). Vazio = sem trava.
WHATSAPP_NUMEROS_PERMITIDOS=
# Versão da Graph API e idioma padrão de template, quando o template não define o dele.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG=pt_BR

# IA de atendimento (Claude, da Anthropic). Sem a chave o worker sobe normal, só sem sugestões.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5
IA_ESFORCO=low

# Onde ficam os arquivos de áudio/figurinha. Opcional: sem definir, usa <raiz do repo>/uploads.
# Precisa ser a MESMA pasta configurada no .env da api.
# UPLOADS_DIR=../../uploads
