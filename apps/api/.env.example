# Painel (tRPC): só a máquina local. Webhook: a única porta que a Meta precisa alcançar.
PAINEL_PORT=3334
PAINEL_HOST=127.0.0.1
WEBHOOK_PORT=3333

DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

# As credenciais do WhatsApp (conta, números, token, webhook) são cadastradas em Configurações,
# no próprio painel, e ficam cifradas no banco. Não há nada de WhatsApp para colocar aqui.

# Onde ficam os arquivos de áudio/figurinha (enviados e recebidos pelo WhatsApp). Opcional: sem definir,
# usa <raiz do repo>/uploads. Precisa ser a MESMA pasta configurada no .env do worker.
# UPLOADS_DIR=../../uploads
